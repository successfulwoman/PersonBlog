---
import FooterAnnouncementEntry from '@components/announcement/FooterAnnouncementEntry';
import { MAX_WIDTH } from '@constants/layout';
import { icpConfig, siteConfig, umamiSiteStatsConfig } from '@constants/site-config';
import { getSiteStats } from '@lib/stats';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import UmamiPVSpan from '@/components/umami/UmamiPVSpan';
import { getLocaleFromUrl, t } from '@/i18n';
import SakuraSVG from '../svg/SakuraSvg';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const stats = await getSiteStats();
// 版权行时间：以东八区(UTC+8)为准的“年份 : 月份”，构建时算一个初始占位，访问者打开后由下方脚本实时刷新
const bjNow = new Date(Date.now() + 8 * 60 * 60 * 1000);
const copyrightYm = `${bjNow.getUTCFullYear()} : ${bjNow.getUTCMonth() + 1}`;
---

<footer class={cn('mt-auto pb-6', className)}>
  <div class={cn('mx-auto flex flex-col items-center gap-3 px-6 md:pb-10 md:px-3', MAX_WIDTH.content)}>
    <!-- Announcements Entry -->
    <FooterAnnouncementEntry client:load />

    <!-- Site Stats -->
    <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-6 text-sm md:gap-4">
      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.totalWordsTitle')}>
        <Icon name="ri:file-text-line" class="h-4 w-4" />
        <span class="font-medium">{stats.formattedWords}</span>
        <span class="text-xs">{t(locale, 'footer.wordUnit')}</span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button type="button" class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.currentTimeTitle')}>
        <Icon name="ri:time-line" class="h-4 w-4" />
        <span class="font-medium tabular-nums" data-footer-now></span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.postCountTitle')}>
        <Icon name="ri:article-line" class="h-4 w-4" />
        <span class="font-medium">{stats.postCount}</span>
        <span class="text-xs">{t(locale, 'footer.postUnit')}</span>
      </button>

      {umamiSiteStatsConfig && (
        <>
          <div class="bg-muted-foreground/30 h-4 w-px"></div>
          <div class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'stats.pageviews')}>
            <Icon name="ri:eye-line" class="h-4 w-4" />
            <span class="font-medium"><UmamiPVSpan client:load statsConfig={umamiSiteStatsConfig} /></span>
            <span class="text-xs">{t(locale, 'stats.pageviews')}</span>
          </div>
        </>
      )}

    </div>

    <!-- Copyright -->
    <div class="text-muted-foreground flex items-center gap-0.5 text-sm">
      <span class="opacity-75">©</span>
      <span class="font-medium opacity-75 tabular-nums" itemprop="copyrightYear" data-footer-ym>
        {copyrightYm}
      </span>
      <SakuraSVG className="mx-1 size-5 animate-spin text-[#FFC0CB] duration-10000" />
      <span class="author font-medium opacity-75" itemprop="copyrightHolder">
        {siteConfig?.alternate ? `@${siteConfig.alternate}` : ''}
      </span>
    </div>

    <!-- ICP Filing -->
    {icpConfig && (
      <div class="text-muted-foreground/80 text-xs">
        {icpConfig.link ? (
          <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link font-medium">
            {icpConfig.text}
          </a>
        ) : (
          <span class="opacity-75">{icpConfig.text}</span>
        )}
      </div>
    )}

    <!-- Powered By -->
    <div class="text-muted-foreground/80 flex items-center gap-2 text-xs">
      <span class="opacity-75">Powered by theme</span>
      <a
        href="https://github.com/cosZone/astro-koharu"
        target="_blank"
        class="footer-link font-medium transition-all duration-300"
      >
        astro-koharu
      </a>
      <span class="opacity-50">·</span>
      <span class="opacity-75">Inspired by</span>
      <a
        href="https://github.com/amehime/hexo-theme-shoka"
        target="_blank"
        class="footer-link font-medium transition-all duration-300"
      >
        Shoka
      </a>
    </div>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (() => {
    // 视图过渡重新执行时先清掉旧计时器，避免叠加
    window.clearInterval(window.__footerClockTimer);
    const elNow = document.querySelector('[data-footer-now]');
    const elYm = document.querySelector('[data-footer-ym]');
    const timeFmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      hour12: false,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
    const yearFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', year: 'numeric' });
    const monthFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', month: 'numeric' });
    const tick = () => {
      const d = new Date();
      if (elNow) elNow.textContent = timeFmt.format(d);
      if (elYm) elYm.textContent = `${yearFmt.format(d)} : ${monthFmt.format(d)}`;
    };
    tick();
    window.__footerClockTimer = window.setInterval(tick, 1000);
  })();
</script>

<style>
  .footer-link {
    opacity: 0.75;
    position: relative;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }
</style>
